{
  "name": "inventory-reservation-system",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend & npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:backend": "npm run test --workspace backend",
    "test:frontend": "npm run test --workspace frontend",
    "lint": "eslint backend/src frontend/src",
    "format": "prettier --write \"backend/src/**/*.js\" \"frontend/src/**/*.{js,jsx}\" \"frontend/*.{js,json}\"",
    "format:check": "prettier --check \"backend/src/**/*.js\" \"frontend/src/**/*.{js,jsx}\" \"frontend/*.{js,json}\"",
    "lint:backend": "eslint backend/src",
    "lint:frontend": "eslint frontend/src",
    "verify:ui": "bash scripts/verify-ui.sh",
    "dev:backend:short-hold": "HOLD_MINUTES=1 npm run dev --workspace backend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  }
}
